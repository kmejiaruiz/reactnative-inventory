# Puerto en el que se ejecutará el servidor Express
PORT=5000

# Configuración de conexión a la Base de Datos MySQL (XAMPP / MySQL Server)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=proyecto_db

# Clave secreta para la firma de tokens JWT (Autenticación)
JWT_SECRET=clave_secreta_para_jwt_12345
